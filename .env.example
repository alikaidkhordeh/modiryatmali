# توکن ربات از @BotFather
BOT_TOKEN=

# شناسهٔ عددی تلگرام خودت (از @userinfobot). چند نفر را با کاما جدا کن: 123,456
# اولین شناسه «مدیر» است: بکاپ کامل دیتابیس فقط برای او فرستاده می‌شود.
ALLOWED_USER_IDS=

# آدرس مینی‌اپ (GitHub Pages). اگر خالی بگذاری، دکمهٔ داشبورد نمایش داده نمی‌شود.
WEBAPP_URL=https://alikaidkhordeh.github.io/modiryatmali/

# مسیر دیتابیس (نسبت به پوشهٔ پروژه)
DB_PATH=data/expenses.db

# ---- اختیاری و پولی: خالی بگذار تا کاملاً رایگان کار کند ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
